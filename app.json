{
  "expo": {
    "name": "Uysal Kelimeler",
    "slug": "uysal-kelimeler",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#020617"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sultanguvenlik.uysalkelimeler"
    },
    "android": {
      "backgroundColor": "#020617",
      "package": "com.sultanguvenlik.uysalkelimeler"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "scheme": "uysal-kelimeler"
  }
}